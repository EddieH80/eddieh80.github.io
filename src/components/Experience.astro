---
import { Image } from "astro:assets";
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div>
          <div>
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Experience
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div>
            <div class="mt-8 grid grid-cols-1 md:grid-cols-2 items-start gap-6 lg:gap-8">
              {siteConfig.experience.map((exp, index) => {
                const image = (exp as { image?: ImageMetadata }).image;
                const logo = (exp as { logo?: ImageMetadata }).logo;

                return (
                  <div
                    class={`group relative isolate overflow-hidden rounded-lg shadow-sm border p-4 sm:p-5 md:p-6 hover:shadow-md transition-shadow duration-300 ${
                      image ? "bg-gray-900 border-gray-800" : "bg-white border-gray-100"
                    }`}
                  >
                    {image && (
                      <>
                        <Image
                          src={image}
                          alt=""
                          width={1200}
                          class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-500 group-hover:scale-105"
                        />
                        <div class="absolute inset-0 -z-10 bg-linear-to-t from-gray-950/95 via-gray-950/80 to-gray-950/50" />
                      </>
                    )}
                    {logo && !image && (
                      <Image
                        src={logo}
                        alt=""
                        width={400}
                        class="pointer-events-none absolute right-4 sm:right-6 top-1/2 -z-10 h-24 sm:h-32 md:h-40 w-auto max-w-[50%] -translate-y-1/2 object-contain opacity-10 grayscale transition-all duration-300 group-hover:opacity-20 group-hover:grayscale-0"
                      />
                    )}
                    <div class="mb-4">
                      <span
                        class={`text-xs sm:text-sm ${image ? "text-gray-300" : "text-gray-500"}`}
                      >
                        {exp.dateRange}
                      </span>
                      <p
                        class={`mt-1 text-base sm:text-lg ${image ? "text-white/80" : ""}`}
                        style={image ? undefined : `color: ${siteConfig.accentColor}`}
                      >
                        {exp.company}
                      </p>
                      <h3
                        class={`text-lg sm:text-xl font-semibold line-clamp-2 min-h-[2lh] ${image ? "text-white" : "text-gray-900"}`}
                      >
                        {exp.title}
                      </h3>
                    </div>

                    <div>
                      <div
                        id={`experience-bullets-${index}`}
                        class="h-[6lh] overflow-hidden text-sm sm:text-base leading-relaxed data-[expanded=true]:h-auto data-[truncated=true]:mask-b-from-40%"
                      >
                        <ul class="space-y-2">
                          {exp.bullets.map((bullet) => (
                            <li class="flex items-start">
                              <span
                                class={`inline-block w-1.5 h-1.5 rounded-full mt-2 mr-3 flex-shrink-0 ${image ? "bg-white/60" : "bg-gray-400"}`}
                              />
                              <span
                                class={`text-sm sm:text-base ${image ? "text-gray-200" : "text-gray-600"}`}
                              >
                                {bullet}
                              </span>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <button
                        type="button"
                        data-expand-toggle
                        aria-expanded="false"
                        aria-controls={`experience-bullets-${index}`}
                        class={`invisible mt-2 text-sm font-medium underline underline-offset-4 cursor-pointer transition-colors duration-300 ${
                          image ? "text-white hover:text-gray-300" : "text-gray-900 hover:text-[var(--accent-color)]"
                        }`}
                      >
                        Read more
                      </button>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  import "../scripts/expandable";
</script>
