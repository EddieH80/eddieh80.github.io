---
import { Image } from "astro:assets";
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Experience
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="relative">
              {siteConfig.experience.map((exp, index) => {
                const image = (exp as { image?: ImageMetadata }).image;

                return (
                <div class="relative mb-12 last:mb-0">
                  {/* Timeline dot at top of card */}
                  <div
                    class="absolute left-1/2 -top-2 w-4 h-4 bg-white border-2 rounded-full -translate-x-1/2 z-20 transition-all duration-300"
                    style={`border-color: ${siteConfig.accentColor}; background-color: ${siteConfig.accentColor}`}
                  />

                  {/* Connecting line below card */}
                  {index < siteConfig.experience.length - 1 && (
                    <div class="absolute left-1/2 bottom-0 w-0.5 h-12 bg-gray-300 -translate-x-1/2 translate-y-full z-10" />
                  )}

                  {/* Experience card */}
                  <div
                    class={`group relative isolate overflow-hidden rounded-lg shadow-sm border p-4 sm:p-5 md:p-6 hover:shadow-md transition-shadow duration-300 ${
                      image ? "bg-gray-900 border-gray-800" : "bg-white border-gray-100"
                    }`}
                  >
                    {image && (
                      <>
                        <Image
                          src={image}
                          alt=""
                          width={1200}
                          class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-500 group-hover:scale-105"
                        />
                        <div class="absolute inset-0 -z-10 bg-linear-to-t from-gray-950/95 via-gray-950/80 to-gray-950/50" />
                      </>
                    )}
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
                      <div>
                        <h3
                          class={`text-lg sm:text-xl font-semibold ${image ? "text-white" : "text-gray-900"}`}
                        >
                          {exp.title}
                        </h3>
                        <p
                          class={`text-base sm:text-lg ${image ? "text-white/80" : ""}`}
                          style={image ? undefined : `color: ${siteConfig.accentColor}`}
                        >
                          {exp.company}
                        </p>
                      </div>
                      <span
                        class={`text-xs sm:text-sm mt-2 sm:mt-0 ${image ? "text-gray-300" : "text-gray-500"}`}
                      >
                        {exp.dateRange}
                      </span>
                    </div>

                    <ul class="space-y-2">
                      {exp.bullets.map((bullet) => (
                        <li class="flex items-start">
                          <span
                            class={`inline-block w-1.5 h-1.5 rounded-full mt-2 mr-3 flex-shrink-0 ${image ? "bg-white/60" : "bg-gray-400"}`}
                          />
                          <span
                            class={`text-sm sm:text-base ${image ? "text-gray-200" : "text-gray-600"}`}
                          >
                            {bullet}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
