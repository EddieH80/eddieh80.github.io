---
import { Image } from "astro:assets";
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Education
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.education.map((edu) => {
                const image = (edu as { image?: ImageMetadata }).image;
                const logo = (edu as { logo?: ImageMetadata }).logo;
                const { startDate, endDate, expected } = edu as {
                  startDate?: string;
                  endDate?: string;
                  expected?: boolean;
                };
                const dates = [
                  startDate && { label: "Started", value: startDate },
                  endDate && {
                    label: expected ? "Expected" : "Graduated",
                    value: endDate,
                  },
                ].filter(Boolean) as { label: string; value: string }[];

                return (
                <div
                  class={`group relative isolate overflow-hidden rounded-lg shadow-sm border p-4 sm:p-5 md:p-6 hover:shadow-md transition-shadow duration-300 ${
                    image ? "bg-gray-900 border-gray-800 text-shadow-md text-shadow-black/60" : "bg-white border-gray-100"
                  }`}
                >
                  {image && (
                    <>
                      <Image
                        src={image}
                        alt=""
                        width={1200}
                        class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                      <div class="absolute inset-0 -z-10 bg-linear-to-t from-gray-950/75 via-gray-950/45 to-gray-950/15" />
                    </>
                  )}
                  {logo && !image && (
                    <Image
                      src={logo}
                      alt=""
                      width={400}
                      class="pointer-events-none absolute right-4 sm:right-6 top-1/2 -z-10 h-24 sm:h-32 md:h-40 w-auto max-w-[50%] -translate-y-1/2 object-contain opacity-10 grayscale transition-all duration-300 group-hover:opacity-20 group-hover:grayscale-0"
                    />
                  )}
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-4">
                    <div>
                      <h3
                        class={`text-lg sm:text-xl font-semibold ${image ? "text-white" : "text-gray-900"}`}
                      >
                        {edu.degree}
                      </h3>
                      <p
                        class={`text-base sm:text-lg ${image ? "text-white/80" : ""}`}
                        style={image ? undefined : `color: ${siteConfig.accentColor}`}
                      >
                        {edu.school}
                      </p>
                    </div>
                    {dates.length > 0 ? (
                      <dl class="grid grid-cols-[auto_auto] justify-start sm:justify-end gap-x-3 gap-y-1 items-baseline mt-2 sm:mt-0 shrink-0">
                        {dates.map(({ label, value }) => (
                          <>
                            <dt
                              class={`text-[10px] sm:text-xs font-semibold uppercase tracking-wider ${image ? "text-white/60" : "text-gray-400"}`}
                            >
                              {label}
                            </dt>
                            <dd
                              class={`text-xs sm:text-sm font-medium sm:text-right ${image ? "text-white" : "text-gray-700"}`}
                            >
                              {value}
                            </dd>
                          </>
                        ))}
                      </dl>
                    ) : (
                      <span
                        class={`text-xs sm:text-sm mt-2 sm:mt-0 ${image ? "text-gray-300" : "text-gray-500"}`}
                      >
                        {(edu as { dateRange?: string }).dateRange}
                      </span>
                    )}
                  </div>

                  <ul class="space-y-2">
                    {edu.achievements.map((achievement) => (
                      <li class="flex items-start">
                        <span
                          class={`inline-block w-1.5 h-1.5 rounded-full mt-2 mr-3 flex-shrink-0 ${image ? "bg-white/60" : "bg-gray-400"}`}
                        />
                        <span
                          class={`text-sm sm:text-base ${image ? "text-gray-200" : "text-gray-600"}`}
                        >
                          {achievement}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
