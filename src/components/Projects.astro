---
import { Image } from "astro:assets";
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const maxShown =
  (siteConfig as { maxProjectsShown?: number }).maxProjectsShown ?? 5;
const getTags = (project: object) => (project as { tags?: string[] }).tags ?? [];
const projectTags = [...new Set(siteConfig.projects.flatMap(getTags))];
---

{
  hasProjects && (
    <section
      id="projects"
      class="p-8 sm:p-12 md:p-16 lg:p-24"
      data-max-shown={maxShown}
      style={`--accent-color: ${siteConfig.accentColor}`}
    >
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Projects
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            {projectTags.length > 0 && (
              <div
                class="flex flex-wrap gap-2 mb-8"
                role="group"
                aria-label="Filter projects by tag"
              >
                {["All", ...projectTags].map((tag) => (
                  <button
                    type="button"
                    data-filter={tag === "All" ? "" : tag}
                    aria-pressed={tag === "All" ? "true" : "false"}
                    class="px-3 sm:px-4 py-1.5 sm:py-2 rounded-full border border-gray-300 text-xs sm:text-sm font-medium text-gray-700 transition-colors duration-300 cursor-pointer hover:border-[var(--accent-color)] hover:text-[var(--accent-color)] aria-pressed:bg-[var(--accent-color)] aria-pressed:border-[var(--accent-color)] aria-pressed:text-white"
                  >
                    {tag}
                  </button>
                ))}
              </div>
            )}

            <div id="project-list" class="flex flex-col gap-8">
              {siteConfig.projects.map((project, index) => {
                const Component = project.link ? "a" : "div";
                const linkProps = project.link
                  ? {
                      href: project.link,
                      target: "_blank",
                      rel: "noopener noreferrer",
                    }
                  : {};
                const image = (project as { image?: ImageMetadata }).image;

                return (
                  <div
                    class="group relative"
                    data-project
                    data-tags={JSON.stringify(getTags(project))}
                  >
                    <Component
                      {...linkProps}
                      class={`block relative isolate overflow-hidden p-4 sm:p-6 md:p-8 rounded-xl sm:rounded-2xl border transition-all duration-300 ${
                        image ? "border-gray-800 bg-gray-900" : "bg-gray-50 border-gray-200"
                      } ${
                        project.link
                          ? `hover:shadow-xl hover:-translate-y-1 ${image ? "" : "hover:bg-white hover:border-gray-300"}`
                          : ""
                      }`}
                    >
                      {image && (
                        <>
                          <Image
                            src={image}
                            alt=""
                            width={1200}
                            class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-500 group-hover:scale-105"
                          />
                          <div class="absolute inset-0 -z-10 bg-linear-to-t from-gray-950/95 via-gray-950/75 to-gray-950/40" />
                        </>
                      )}
                      {project.link && (
                        <div
                          class={`absolute top-4 right-4 sm:top-6 sm:right-6 md:top-8 md:right-8 w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center rounded-full transition-all duration-300 ${
                            image
                              ? "bg-white text-gray-900 group-hover:bg-gray-200"
                              : "bg-gray-900 text-white group-hover:bg-gray-700"
                          }`}
                        >
                          <svg
                            class="w-4 h-4 sm:w-4.5 sm:h-4.5 md:w-5 md:h-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 17L17 7M17 7H7M17 7V17"
                            />
                          </svg>
                        </div>
                      )}

                      <div class="space-y-4">
                        <div>
                          <span
                            class={`text-sm font-mono ${image ? "text-white/70" : ""}`}
                            style={image ? undefined : { color: siteConfig.accentColor }}
                          >
                            {String(index + 1).padStart(2, "0")}
                          </span>
                          <h3
                            class={`text-xl sm:text-2xl font-bold mt-1 ${image ? "text-white" : "text-gray-900"}`}
                          >
                            {project.name}
                          </h3>
                        </div>

                        <p
                          class={`text-base sm:text-lg leading-relaxed ${image ? "text-gray-200" : "text-gray-600"} ${project.link ? "pr-12 sm:pr-14 md:pr-16" : ""}`}
                        >
                          {project.description}
                        </p>

                        {project.skills && project.skills.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                            {project.skills.map((skill) => (
                              <span
                                class={`px-2.5 sm:px-3 py-1 sm:py-1.5 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 ${
                                  image ? "bg-white/15 backdrop-blur-sm" : "bg-gray-900"
                                } ${project.link && !image ? "group-hover:bg-gray-800" : ""}`}
                              >
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </Component>
                  </div>
                );
              })}
            </div>

            <button
              type="button"
              data-project-toggle
              aria-expanded="false"
              aria-controls="project-list"
              hidden
              class="mt-8 mx-auto flex items-center gap-2 px-5 py-2.5 rounded-full border border-gray-300 text-sm font-medium text-gray-700 transition-colors duration-300 cursor-pointer hover:border-[var(--accent-color)] hover:text-[var(--accent-color)] aria-expanded:[&>svg]:rotate-180"
            >
              <span data-toggle-label>Show more projects</span>
              <svg
                class="w-4 h-4 transition-transform duration-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 9l6 6 6-6"
                />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  const section = document.getElementById("projects");

  if (section) {
    const maxShown = Number(section.dataset.maxShown);
    const items = [...section.querySelectorAll<HTMLElement>("[data-project]")];
    const filters = [
      ...section.querySelectorAll<HTMLButtonElement>("[data-filter]"),
    ];
    const toggle = section.querySelector<HTMLButtonElement>(
      "[data-project-toggle]",
    );
    const toggleLabel = toggle?.querySelector("[data-toggle-label]");

    let activeTag = "";
    let expanded = false;

    // Show only projects matching the active tag, capped at maxShown unless
    // the list is expanded. Projects are all visible without JavaScript.
    const render = () => {
      const matches = items.filter(
        (item) =>
          !activeTag ||
          (JSON.parse(item.dataset.tags ?? "[]") as string[]).includes(
            activeTag,
          ),
      );
      items.forEach((item) => (item.hidden = true));
      matches.forEach((item, i) => (item.hidden = !expanded && i >= maxShown));

      const extra = matches.length - maxShown;
      if (toggle && toggleLabel) {
        toggle.hidden = extra <= 0;
        if (toggle.hidden) return;
        toggle.setAttribute("aria-expanded", String(expanded));
        toggleLabel.textContent = expanded
          ? "Show fewer projects"
          : `Show ${extra} more project${extra === 1 ? "" : "s"}`;
      }
    };

    filters.forEach((button) =>
      button.addEventListener("click", () => {
        activeTag = button.dataset.filter ?? "";
        expanded = false;
        filters.forEach((b) =>
          b.setAttribute("aria-pressed", String(b === button)),
        );
        render();
      }),
    );

    toggle?.addEventListener("click", () => {
      expanded = !expanded;
      render();
      if (!expanded) toggle.scrollIntoView({ block: "nearest" });
    });

    render();
  }
</script>
